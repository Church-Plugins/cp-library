{
  "name": "churchplugins/cp-library",
  "type": "wordpress-plugin",
  "description": "Church library plugin for sermons, talks, and other media.",
  "keywords": [],
  "homepage": "https://churchplugins.com",
  "authors": [
    {
      "name": "Tanner Moushey",
      "email": "tanner@churchplugins.com",
      "homepage": "https://churchplugins.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "composer/installers": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "CP_Library\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CP_Library\\Tests\\": "tests/",
      "ChurchPlugins\\": "includes/ChurchPlugins/"
    }
  },
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
    "test:integration": "@php vendor/bin/phpunit --configuration phpunit-integration.xml.dist",
    "verify": [
      "@test"
    ]
  }
}
